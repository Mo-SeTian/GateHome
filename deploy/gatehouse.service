[Unit]
Description=Gatehouse DDNS and reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gatehouse
Group=gatehouse
WorkingDirectory=/etc/gatehome
ExecStart=/etc/gatehome/launcher -supervise -managed-root /etc/gatehome/app -config /etc/gatehome/config -log /etc/gatehome/log -data /etc/gatehome/data -admin 0.0.0.0:16666
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/gatehome/app /etc/gatehome/config /etc/gatehome/log /etc/gatehome/data /etc/gatehome/sunpanel
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
